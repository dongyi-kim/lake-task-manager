{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lake-task-manager.local/schemas/agent-mcp.schema.json",
  "title": "Lake Task Manager external MCP configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["servers"],
  "properties": {
    "_comment": {"type": "string"},
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "read_tools", "enabled"],
        "properties": {
          "_comment": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "args": {"type": "array", "items": {"type": "string"}},
          "env": {
            "type": "object",
            "additionalProperties": {"type": ["string", "number", "boolean"]}
          },
          "read_tools": {
            "description": "Exact remote MCP tool names explicitly classified as read-only.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
