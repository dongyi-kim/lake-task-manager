# Lake Task Manager — 환경 설정 예시
# 실제 값은 .env 로 복사해 채운다 (.env 는 git 제외).
#   cp .env.example .env

# ── 환경 선택 ────────────────────────────────────────────────
# mock : Jira 없이 결정적 가상 데이터로 전체 앱 구동 (개발/UI 확인용, 기본값)
# local: Fake Jira 서버(src/tools/fake_jira, basic auth) — dev 는 src/.env.dev 사용
# prod : 사내 Jira DC (Playwright SSO 세션 재사용)
JIRA_ENV=mock

# ── Jira 접속 ────────────────────────────────────────────────
JIRA_BASE=http://localhost:8080
PROJECT_KEY=DL

# local: basic auth 또는 PAT
JIRA_USER=admin
JIRA_TOKEN=admin
# PAT 를 쓰면 JIRA_TOKEN 에 토큰을 넣고 JIRA_AUTH=bearer
JIRA_AUTH=basic            # basic | bearer

# prod: SSO 세션 파일 (Playwright storage_state). git 제외.
JIRA_STATE_PATH=jira_state.json

# ── 커스텀 필드 ID (인스턴스마다 다름. /rest/api/2/field 로 확인) ──
SP_FIELD_ID=customfield_10004
EPIC_LINK_FIELD_ID=customfield_10008

# ── Confluence (기능3 활동 요약, 선택) ───────────────────────
CONFLUENCE_BASE=http://localhost:8090

# ── 캐시 ─────────────────────────────────────────────────────
CACHE_DB_PATH=cache.sqlite3
CACHE_TTL_SECONDS=900       # 15분

# ── 앱 서버 ──────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
