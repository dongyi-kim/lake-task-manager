# docker compose 가 자동으로 읽는 LLM 설정. `cp .env.example .env` 후 값을 채우세요.
# (하나도 안 채워도 됩니다 — 실행 후 화면 좌상단 ⚙ 설정에서 키를 넣거나,
#  fake provider 로 UI·HITL 흐름을 확인할 수 있습니다.)

# ── Azure OpenAI (권장: 채점 환경 표준) ─────────────────────────
AOAI_ENDPOINT=
AOAI_API_KEY=
AOAI_DEPLOY_GPT4O_MINI=
AOAI_DEPLOY_EMBED_3_SMALL=
AOAI_API_VERSION=2024-10-21

# ── 또는 OpenAI 직접 ────────────────────────────────────────────
# LAKE_AGENT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
