{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ltm:maxis:editor-plan.v2",
  "title": "EditorPlanV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "status", "sections", "missing_inputs"],
  "properties": {
    "contract": {"type": "string", "const": "editor-plan.v2"},
    "status": {"type": "string", "enum": ["ok", "needs_input", "blocked"]},
    "sections": {
      "type": "array", "maxItems": 4,
      "items": {"$ref": "#/$defs/section"}
    },
    "missing_inputs": {
      "type": "array", "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["section", "blocks"],
      "properties": {
        "section": {"type": "string", "enum": ["background", "scope", "work", "dod", "comment"]},
        "blocks": {"type": "array", "minItems": 1, "maxItems": 32,
          "items": {"oneOf": [{"$ref": "#/$defs/fact"}, {"$ref": "#/$defs/proposal"}, {"$ref": "#/$defs/link"}]}}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "unit_id", "tag"],
      "properties": {
        "type": {"type": "string", "const": "fact"},
        "unit_id": {"$ref": "#/$defs/identifier"},
        "tag": {"type": "string", "enum": ["p", "li"]}
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text", "source_ids", "tag"],
      "properties": {
        "type": {"type": "string", "const": "proposal"},
        "text": {"type": "string", "minLength": 1, "maxLength": 1200},
        "source_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}},
        "tag": {"type": "string", "enum": ["p", "li"]}
      }
    },
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "source_id"],
      "properties": {
        "type": {"type": "string", "const": "link"},
        "source_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
