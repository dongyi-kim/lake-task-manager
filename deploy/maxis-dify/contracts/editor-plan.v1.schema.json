{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ltm:maxis:editor-plan.v1",
  "title": "EditorPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "status", "blocks", "missing_inputs"],
  "properties": {
    "contract": {"type": "string", "const": "editor-plan.v1"},
    "status": {"type": "string", "enum": ["ok", "needs_input", "blocked"]},
    "blocks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/quote"},
          {"$ref": "#/$defs/proposal"},
          {"$ref": "#/$defs/seed"},
          {"$ref": "#/$defs/link"}
        ]
      }
    },
    "missing_inputs": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 1200},
    "quote": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "tag", "source_id", "text"],
      "properties": {
        "type": {"type": "string", "const": "quote"},
        "tag": {"type": "string", "enum": ["p", "li"]},
        "source_id": {"$ref": "#/$defs/identifier"},
        "text": {"$ref": "#/$defs/text"}
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "tag", "text", "source_ids"],
      "properties": {
        "type": {"type": "string", "const": "proposal"},
        "tag": {"type": "string", "enum": ["p", "li", "h2"]},
        "text": {"$ref": "#/$defs/text"},
        "source_ids": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "source_id"],
      "properties": {
        "type": {"type": "string", "const": "seed"},
        "source_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "source_id"],
      "properties": {
        "type": {"type": "string", "const": "link"},
        "source_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
