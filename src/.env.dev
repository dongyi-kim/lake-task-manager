# === 개발(dev) — Fake Jira/Confluence 서버 (무설치·무라이선스) ===
# 1) 먼저 fake 서버:   cd src && python run_fake.py            (:8080)
# 2) 앱:               LAKE_DOTENV=.env.dev python src/run.py  (local → fake 로 붙음)
# 브라우저/SSO 없음. requests basic auth 직접 호출(진짜 HTTP 경로 검증).

JIRA_ENV=local
JIRA_BASE=http://localhost:8080        # fake Jira 서버
PROJECT_KEY=DL

# fake 는 아무 basic auth 나 수용
JIRA_USER=admin
JIRA_TOKEN=admin
JIRA_AUTH=basic

# fake /rest/api/2/field 가 주는 값과 일치
SP_FIELD_ID=customfield_10004
EPIC_LINK_FIELD_ID=customfield_10008

CONFLUENCE_BASE=http://localhost:8080  # fake 가 Confluence CQL 도 같은 호스트로 서빙

CACHE_DB_PATH=cache-dev.sqlite3
CACHE_TTL_SECONDS=900
APP_HOST=127.0.0.1
APP_PORT=8000
