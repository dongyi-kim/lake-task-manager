# === 운영(prod) — 사내 Jira DC (SSO 세션 재사용) ===
# 사용:  LAKE_DOTENV=.env.prod python src/run.py     (개발자 테스트 시)
#        exe 배포 시엔 이 내용을 exe 옆 .env 로 둔다.
#
# basic auth 안 씀. 대신 설치된 Chrome 으로 사내 SSO 를 1회 통과해 세션을 저장하고,
# 그 세션(storage_state)을 재사용해 REST 호출한다. (자세한 동작은 아래/앱 문서 참고)
#   최초 1회:  python -m app.auth.sso_session login   (또는  lake-task-manager.exe login)

JIRA_ENV=prod
JIRA_BASE=https://jira.내회사.com       # 사내 Jira 실제 주소로 교체 (끝에 / 없이)
PROJECT_KEY=DL

# SSO 세션 파일 (Playwright storage_state). 절대 git 커밋 금지(.gitignore).
JIRA_STATE_PATH=jira_state.json

# 사내 인스턴스의 실제 커스텀 필드 ID (/rest/api/2/field 로 확인)
SP_FIELD_ID=customfield_10004
EPIC_LINK_FIELD_ID=customfield_10008

CONFLUENCE_BASE=https://confluence.내회사.com

CACHE_DB_PATH=cache-prod.sqlite3
CACHE_TTL_SECONDS=900
APP_HOST=127.0.0.1
APP_PORT=8000
